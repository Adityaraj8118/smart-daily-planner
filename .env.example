# Copy this file to ".env" and fill it in.
# Without SMTP settings the app runs in dev mode: OTP codes are printed in the server console.

# --- Email (Gmail example: turn on 2-Step Verification, then create an App Password
#     at https://myaccount.google.com/apppasswords and paste it below) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=Smart Daily Planner <your.address@gmail.com>

# --- Push notifications ---
# Contact sent to push services (mailto: or https: URL)
VAPID_CONTACT=mailto:your.address@gmail.com
# Daily reminder is sent after this hour in each user's local time (0-23)
NOTIFY_HOUR=8

# --- Server ---
HOST=127.0.0.1
PORT=5000
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
